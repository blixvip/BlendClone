{
  "name": "BlendClone",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  // FFmpeg/ffprobe for the reference-video tests; Blender 5.1+ is not installed
  // (the test suite mocks it). Install it yourself for scripts/renderer_check.py.
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends ffmpeg && python -m pip install -r requirements.lock.txt",
  "forwardPorts": [4331],
  "portsAttributes": {
    "4331": { "label": "BlendClone app" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.testing.pytestEnabled": true
      }
    }
  }
}
